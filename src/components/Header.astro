---
import { site } from "../data/site";
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand">{site.name}</a>
    <nav>
      {site.nav.map((item) => (
        <a href={item.href} class:list={[{ active: path === item.href }]}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>