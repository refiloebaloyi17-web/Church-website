---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const beliefs = [
  { title: "The Bible", text: "We believe the Bible is the inspired, authoritative Word of God and a final authority in everything we do." },
  { title: "One God", text: "We believe in one God, eternally existing as Father, Son and Holy Spirit." },
  { title: "Salvation", text: "We believe salvation is a gift of grace, received by faith in Jesus Christ." },
  { title: "Healing", text: "We believe God heals today, in body, mind and spirit." },
  { title: "The Holy Spirit", text: "We believe in water baptism, in the baptism of the Holy Spirit and fire, and in the ongoing work of the Holy Spirit." },
  { title: "The Church", text: "We believe in gathering together to worship, pray and serve one another, God's people and the nations." },
];
---
<Layout title="About" description={`About ${site.name}`}>
  <div class="container">
    <h1 class="page-title">About Us</h1>
    <p class="lead">{site.tagline}</p>

       <h2 class="section-title">Our theme: Arise, Shine</h2>
    <blockquote class="theme-quote">Isaiah 60</blockquote>
    <p>
      “Arise, Shine”, calls our church to rise in faith, walk in
      God’s light, and boldly reflect His glory.
    </p>
    <p>
      This is a season of growth, restoration, favour, and transformation as
      we trust God to lead us forward.
    </p>
    <p>
      Together, we arise and shine, believing that God’s glory is upon us and
      His light will shine through our church.
    </p>

       <h2 class="section-title">Who we are</h2>
       <div class="cards">
         <article class="card">
        <h3 class="card-day-title">Our motto</h3>
        <p>{site.motto || site.tagline}</p>
      </article>
      {site.vision && (
        <article class="card">
          <h3 class="card-day-title">Our vision</h3>
          <p>{site.vision}</p>
        </article>
      )}
      <article class="card">
        <h3 class="card-day-title">Our mission</h3>
        <p>{site.mission}</p>
      </article>
    </div>

    <h2 class="section-title" id="beliefs">What we believe</h2>
    <div class="cards">
      {beliefs.map((b) => (
        <article class="card">
          <h3 class="card-day-title">{b.title}</h3>
          <p>{b.text}</p>
        </article>
      ))}
    </div>

      <h2 class="section-title" id="leadership">Our leadership</h2>
    <div class="cards">
      <article class="card">
        <h3 class="card-day-title">Pastor Moses Ngomane &amp; Lady Pastor Ngomane</h3>
        <p class="slot-note">Senior Pastors</p>
        <p>
          Pastor Ngomane and Lady Pastor Ngomane are the senior pastors of
          Healing Center True Gospel Church. Pastor Ngomane has a passion for
          preaching the gospel, teaching the Word of God, and leading people
          into a deeper relationship with Jesus Christ.
        </p>
      </article>
      <article class="card">
        <h3 class="card-day-title">Prophet &amp; Lady Prophet Rasebetlela</h3>
        <p class="slot-note">Prophet and Lady Prophet</p>
      </article>
    </div>

    <h3 class="sub-title">Assistant pastors</h3>
    <div class="cards">
      <article class="card"><h3 class="card-day-title">Lady Pastor Phakale</h3></article>
      <article class="card"><h3 class="card-day-title">Pastor &amp; Lady Pastor Masilo</h3></article>
      <article class="card"><h3 class="card-day-title">Pastor Mary</h3></article>
      <article class="card"><h3 class="card-day-title">Apostle Mizei</h3></article>
    </div>

    <p style="margin-top: 2.5rem;">
      <a class="button" href="/services">Join us this week</a>
    </p>
  </div>
</Layout>