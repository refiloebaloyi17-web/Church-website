---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const g = site.giving;

const accounts = g.accounts
  .filter((a) => !a.hidden)
  .map((a) => ({
    ...a,
    ready: Boolean(a.accountNumber),
    rows: [
      { label: "Account name", value: a.accountName },
      { label: "Bank", value: a.bank },
      { label: "Account type", value: a.accountType },
      { label: "Account number", value: a.accountNumber, copy: true },
      { label: "Branch code", value: a.branchCode, copy: true },
      { label: "Reference", value: a.reference },
    ].filter((r) => r.value),
  }));

const hasCard = accounts.some((a) => a.payUrl);
---
<Layout title="Give" description="Support the work of the church">
  <div class="container">
    <h1 class="page-title">Give</h1>
    <p class="lead">
      Thank you for your generosity. Your giving supports the work of the ministry
      and helps us reach our community with hope and healing.
    </p>

    <div class="cards">
      {accounts.map((a) => (
        <section class="card">
          <h2 class="card-day-title">{a.title}</h2>
          {a.description && <p class="slot-note give-desc">{a.description}</p>}
          {a.ready ? (
            <dl class="bank">
              {a.rows.map((r) => (
                <div class="bank-row">
                  <dt>{r.label}</dt>
                  <dd>
                    <span>{r.value}</span>
                    {r.copy && (
                      <button type="button" class="copy" data-copy={r.value}>Copy</button>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          ) : (
            <p>Bank details coming soon.</p>
          )}
          {a.payUrl && (
            <p style="margin-top: 1rem;">
              <a class="button" href={a.payUrl} target="_blank" rel="noopener">Give by card</a>
            </p>
          )}
        </section>
      ))}
    </div>

    <h2 class="section-title">How to give</h2>
    <ol class="steps">
      <li>Choose the account that matches your giving.</li>
      <li>Give by EFT: add the account as a beneficiary in your banking app and use your name and the type of giving as the reference.</li>
      {hasCard && (
        <li>Give by card: tap <strong>Give by card</strong>. You will pay on a secure page run by our payment provider. We never see or store your card details.</li>
      )}
      <li>
        Email your proof of payment to
        <a href={`mailto:${g.proofEmail}`}>{g.proofEmail}</a>
        if you would like a record.
      </li>
    </ol>

    <blockquote class="theme-quote" style="margin-top: 2.5rem;">
      “God loves a cheerful giver.” 2 Corinthians 9:7
    </blockquote>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        const old = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = old), 1500);
      } catch {
        btn.textContent = "Press Ctrl+C";
      }
    });
  });
</script>