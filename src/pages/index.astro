---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { events } from "../data/events";

const sunday = site.services.find((d) => d.day === "Sunday");
const sundayItems = sunday ? sunday.items : [];
const sundayTimes = sundayItems.map((i) => i.time).join(" and ");
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`;

const today = new Date().toISOString().slice(0, 10);
const weekday = (d: Date) => d.toLocaleString("en-ZA", { weekday: "long" });

const upcoming = events
  .filter((e) => (e.endDate || e.date) >= today)
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3)
  .map((e) => {
    const d = new Date(e.date + "T00:00:00");
    const end = e.endDate ? new Date(e.endDate + "T00:00:00") : null;
    return {
      ...e,
      month: d.toLocaleString("en-ZA", { month: "short" }),
      day: end ? `${d.getDate()}-${end.getDate()}` : String(d.getDate()),
      details: [
        end ? `${weekday(d)} to ${weekday(end)}` : weekday(d),
        e.time,
        e.location,
      ]
        .filter(Boolean)
        .join(", "),
    };
  });

const links = [
  { title: "About", text: "Our story and what we believe", href: "/about" },
  { title: "Sermons", text: "Watch and listen", href: "/sermons" },
  { title: "Gallery", text: "Our church family", href: "/gallery" },
  { title: "Give", text: "Support the ministry", href: "/give" },
  { title: "Contact", text: "Send a prayer request", href: "/contact" },
];
---
<Layout title="Home" home={true}>
  <section class="hero-home">
    <div class="container hero-inner">
      <h1 class="hero-title">{site.tagline}.</h1>
      <p class="hero-sub">Join us this Sunday at {sundayTimes}.</p>
      <div class="hero-actions">
        <a class="button light" href="/visit">Plan your visit</a>
        <a class="button ghost" href="/sermons">Watch a sermon</a>
      </div>
    </div>
  </section>

  <section class="band band-blood">
    <div class="container">
      <h2>This Sunday</h2>
      <div class="sunday-times">
        {sundayItems.map((i) => (
          <div>
            <p class="time">{i.time}</p>
            <p class="time-name">{i.name}</p>
          </div>
        ))}
      </div>
      <p class="sunday-where">{site.address}. <a href={directions}>Get directions</a></p>
    </div>
  </section>

  <section class="band statement">
    <div class="container">
      <h2>Arise, shine.</h2>
      <p>
        This is a season of growth, restoration, favour and transformation.
        Together we trust God to lead us forward, believing that His light
        will shine through our church.
      </p>
      <p><a href="/about">Our story and what we believe</a></p>
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="band band-soft">
      <div class="container">
        <h2>Coming up</h2>
        <div class="event-list">
          {upcoming.map((e) => (
            <article class="event">
              <div class="event-date">
                <span class="event-month">{e.month}</span>
                <span class="event-day">{e.day}</span>
              </div>
              <div class="event-body">
                <h3>{e.title}</h3>
                <p class="slot-note">{e.details}</p>
                <p>{e.description}</p>
              </div>
            </article>
          ))}
        </div>
        <p style="margin-top: 1.5rem;"><a class="button" href="/events">See all events</a></p>
      </div>
    </section>
  )}

  <section class="band">
    <div class="container">
      <h2>Every week</h2>
      <ul class="week">
        {site.services.map((d) => (
          <li class="week-row">
            <span class="week-day">{d.day}</span>
            <span>
              {d.items.map((i) => (
                <span class="week-item"><strong>{i.time}</strong> {i.name}</span>
              ))}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band-black">
    <div class="container">
      <h2>Explore</h2>
      {links.map((l) => (
        <a class="big-link" href={l.href}>{l.title} <span>{l.text}</span></a>
      ))}
    </div>
  </section>

  <section class="band band-blood closing">
    <div class="container">
      <h2>Come as you are.</h2>
      <p>Whatever you are facing, there is a seat for you and people who will pray with you.</p>
      <div class="hero-actions">
        <a class="button light" href="/visit">Plan your visit</a>
        <a class="button ghost" href="/contact">Send a prayer request</a>
      </div>
    </div>
  </section>
</Layout>